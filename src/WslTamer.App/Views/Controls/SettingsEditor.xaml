<UserControl
    x:Class="WslTamer.App.Views.Controls.SettingsEditor"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:WslTamer.App.ViewModels"
    x:Name="Root">
    <ItemsControl x:Name="List" Focusable="False">
        <ItemsControl.GroupStyle>
            <GroupStyle>
                <GroupStyle.HeaderTemplate>
                    <DataTemplate>
                        <TextBlock Style="{StaticResource SectionHeader}" Text="{Binding Name}" />
                    </DataTemplate>
                </GroupStyle.HeaderTemplate>
            </GroupStyle>
        </ItemsControl.GroupStyle>
        <ItemsControl.ItemTemplate>
            <DataTemplate DataType="{x:Type vm:SettingRowViewModel}">
                <ui:Card Margin="0,0,0,4" Padding="16,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MinWidth="200" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,16,0" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource CardTitle}" Text="{Binding Label}" />
                                <Border Style="{StaticResource Pill}" Visibility="{Binding RequiresWindows11, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Style="{StaticResource PillText}" Text="Windows 11" />
                                </Border>
                            </StackPanel>
                            <TextBlock Style="{StaticResource Caption}" Text="{Binding Description}" />
                            <TextBlock
                                Margin="0,2,0,0"
                                FontFamily="Cascadia Mono, Consolas"
                                Opacity="0.7"
                                Style="{StaticResource Caption}"
                                Text="{Binding KeyText}" />
                            <TextBlock
                                Margin="0,4,0,0"
                                Style="{StaticResource ErrorText}"
                                Text="{Binding Error}"
                                Visibility="{Binding Error, Converter={StaticResource NullToVisibility}}" />
                        </StackPanel>

                        <Grid Grid.Column="1" Width="240" VerticalAlignment="Center">
                            <ui:TextBox
                                AutomationProperties.Name="{Binding Label}"
                                PlaceholderText="{Binding Placeholder}"
                                Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}"
                                Visibility="{Binding UsesOptions, Converter={StaticResource InverseBoolToVisibility}}" />
                            <ComboBox
                                HorizontalAlignment="Stretch"
                                AutomationProperties.Name="{Binding Label}"
                                ItemsSource="{Binding Options}"
                                SelectedItem="{Binding SelectedOption}"
                                Visibility="{Binding UsesOptions, Converter={StaticResource BoolToVisibility}}" />
                        </Grid>

                        <ui:Button
                            Grid.Column="2"
                            Margin="8,0,0,0"
                            VerticalAlignment="Center"
                            Appearance="Transparent"
                            AutomationProperties.Name="{Binding Label, StringFormat='Remove {0}'}"
                            Command="{Binding RemoveCommand}"
                            Icon="{ui:SymbolIcon Dismiss24}"
                            ToolTip="Stop managing this setting in the profile"
                            Visibility="{Binding CanRemove, Converter={StaticResource BoolToVisibility}}" />
                    </Grid>
                </ui:Card>
            </DataTemplate>
        </ItemsControl.ItemTemplate>
    </ItemsControl>
</UserControl>
