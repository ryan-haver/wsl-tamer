<ui:FluentWindow
    x:Class="WslTamer.App.Views.Dialogs.DistroConfigWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:WslTamer.App.Views.Controls"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="Distribution settings"
    Width="760"
    Height="680"
    MinWidth="600"
    MinHeight="400"
    ExtendsContentIntoTitleBar="True"
    ShowInTaskbar="False"
    WindowBackdropType="Mica"
    WindowStartupLocation="CenterOwner">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar x:Name="TitleBar" Title="Distribution settings" />

        <ScrollViewer Grid.Row="1" Style="{StaticResource PageScroller}">
            <StackPanel>
                <TextBlock x:Name="Heading" Style="{StaticResource PageTitle}" />
                <TextBlock Style="{StaticResource PageSubtitle}" Text="Settings in /etc/wsl.conf. Leave a field empty to use WSL's default. Lines this editor doesn't know about are kept unchanged, and the previous file is saved as /etc/wsl.conf.wsltamer.bak." />

                <StackPanel x:Name="Loading" Orientation="Horizontal">
                    <ui:ProgressRing
                        Width="18"
                        Height="18"
                        IsIndeterminate="True" />
                    <TextBlock
                        Margin="8,0,0,0"
                        VerticalAlignment="Center"
                        Text="Reading /etc/wsl.conf (this starts the distribution)…" />
                </StackPanel>

                <ui:InfoBar
                    x:Name="LoadError"
                    Title="Couldn't read the settings"
                    IsClosable="False"
                    Severity="Error" />

                <controls:SettingsEditor x:Name="Editor" />

                <StackPanel x:Name="OtherPanel" Visibility="Collapsed">
                    <TextBlock Style="{StaticResource SectionHeader}" Text="Other lines in wsl.conf (kept as-is)" />
                    <ui:Card Padding="12">
                        <TextBlock
                            x:Name="OtherLines"
                            FontFamily="Cascadia Mono, Consolas"
                            TextWrapping="Wrap" />
                    </ui:Card>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <Border
            Grid.Row="2"
            Padding="24,12"
            Background="{DynamicResource ApplicationBackgroundBrush}"
            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
            BorderThickness="0,1,0,0">
            <Grid>
                <CheckBox
                    x:Name="RestartAfterSave"
                    VerticalAlignment="Center"
                    Content="Restart the distribution after saving"
                    IsChecked="True" />
                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                    <ui:Button
                        x:Name="SaveButton"
                        Margin="0,0,8,0"
                        Appearance="Primary"
                        Click="Save_Click"
                        Content="Save"
                        IsEnabled="False" />
                    <ui:Button Click="Cancel_Click" Content="Cancel" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</ui:FluentWindow>
