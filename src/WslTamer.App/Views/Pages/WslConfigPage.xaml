<Page
    x:Class="WslTamer.App.Views.Pages.WslConfigPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:WslTamer.App.Views.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:WslTamer.App.ViewModels"
    Title="WSL settings"
    d:DataContext="{d:DesignInstance vm:WslConfigViewModel}"
    mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <ScrollViewer Style="{StaticResource PageScroller}">
            <StackPanel MaxWidth="900">
                <TextBlock Style="{StaticResource PageTitle}" Text="WSL settings" />
                <TextBlock Style="{StaticResource PageSubtitle}">
                    <Run Text="Global settings in" />
                    <Run FontFamily="Cascadia Mono, Consolas" Text="{Binding FilePath, Mode=OneWay}" />
                    <Run Text=". Leave a field empty to use WSL's default. Comments and settings not listed here are kept, and the previous file is saved as .wslconfig.wsltamer.bak." />
                </TextBlock>

                <controls:SettingsEditor ItemsSource="{Binding Rows}" />

                <StackPanel Visibility="{Binding OtherLines, Converter={StaticResource NullToVisibility}}">
                    <TextBlock Style="{StaticResource SectionHeader}" Text="Other settings in your file (kept as-is)" />
                    <ui:Card Padding="12">
                        <TextBlock
                            FontFamily="Cascadia Mono, Consolas"
                            Text="{Binding OtherLines}"
                            TextWrapping="Wrap" />
                    </ui:Card>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <Border
            Grid.Row="1"
            Padding="24,12"
            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
            BorderThickness="0,1,0,0">
            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                <ui:Button
                    Margin="0,0,8,0"
                    Command="{Binding OpenInEditorCommand}"
                    Content="Edit in Notepad"
                    Icon="{ui:SymbolIcon DocumentEdit24}" />
                <ui:Button
                    Margin="0,0,8,0"
                    Command="{Binding ReloadCommand}"
                    Content="Discard changes"
                    Icon="{ui:SymbolIcon ArrowSync24}" />
                <ui:Button
                    Appearance="Primary"
                    Command="{Binding SaveCommand}"
                    Content="Save"
                    Icon="{ui:SymbolIcon Save24}" />
            </StackPanel>
        </Border>
    </Grid>
</Page>
