<Page
    x:Class="WslTamer.App.Views.Pages.DistributionsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:WslTamer.App.ViewModels"
    x:Name="Root"
    Title="Distributions"
    d:DataContext="{d:DesignInstance vm:DistributionsViewModel}"
    mc:Ignorable="d">
    <ScrollViewer Style="{StaticResource PageScroller}">
        <StackPanel MaxWidth="900">
            <Grid>
                <StackPanel>
                    <TextBlock Style="{StaticResource PageTitle}" Text="Distributions" />
                    <TextBlock Style="{StaticResource PageSubtitle}" Text="Start, stop, back up and manage your Linux distributions." />
                </StackPanel>
                <StackPanel
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Orientation="Horizontal">
                    <ui:Button
                        Margin="4,0"
                        Appearance="Primary"
                        Command="{Binding InstallCommand}"
                        Content="Install"
                        Icon="{ui:SymbolIcon Add24}" />
                    <ui:Button
                        Margin="4,0"
                        Command="{Binding ImportCommand}"
                        Content="Import"
                        Icon="{ui:SymbolIcon ArrowDownload24}" />
                    <ui:Button
                        AutomationProperties.Name="Refresh"
                        Margin="4,0,0,0"
                        Command="{Binding RefreshCommand}"
                        Icon="{ui:SymbolIcon ArrowSync24}"
                        ToolTip="Refresh" />
                </StackPanel>
            </Grid>

            <StackPanel
                Margin="0,0,0,12"
                Orientation="Horizontal"
                Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}">
                <ui:ProgressRing
                    Width="18"
                    Height="18"
                    IsIndeterminate="True" />
                <TextBlock
                    Margin="8,0,0,0"
                    VerticalAlignment="Center"
                    Text="{Binding BusyText}" />
            </StackPanel>

            <ui:Card Padding="24" Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock
                        HorizontalAlignment="Center"
                        FontSize="16"
                        FontWeight="SemiBold"
                        Text="No distributions installed" />
                    <TextBlock
                        HorizontalAlignment="Center"
                        Style="{StaticResource Caption}"
                        Text="Choose Install to add Ubuntu, Debian, Fedora and others." />
                </StackPanel>
            </ui:Card>

            <ItemsControl ItemsSource="{Binding Distributions}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:DistroItemViewModel}">
                        <ui:Card Margin="0,0,0,8" Padding="16,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Border
                                    Width="40"
                                    Height="40"
                                    VerticalAlignment="Center"
                                    Background="{DynamicResource ControlFillColorSecondaryBrush}"
                                    CornerRadius="8">
                                    <ui:SymbolIcon FontSize="20" Symbol="WindowConsole20" />
                                </Border>

                                <StackPanel
                                    Grid.Column="1"
                                    Margin="16,0"
                                    VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock
                                            FontSize="15"
                                            FontWeight="SemiBold"
                                            Text="{Binding Name}" />
                                        <Border Style="{StaticResource Pill}" Visibility="{Binding IsDefault, Converter={StaticResource BoolToVisibility}}">
                                            <TextBlock Style="{StaticResource PillText}" Text="Default" />
                                        </Border>
                                        <Border Style="{StaticResource Pill}" Visibility="{Binding KeepAlive, Converter={StaticResource BoolToVisibility}}">
                                            <TextBlock Style="{StaticResource PillText}" Text="Kept running" />
                                        </Border>
                                    </StackPanel>
                                    <StackPanel Margin="0,2,0,0" Orientation="Horizontal">
                                        <Ellipse
                                            x:Name="Dot"
                                            Width="8"
                                            Height="8"
                                            Margin="0,0,6,0"
                                            VerticalAlignment="Center"
                                            Fill="#8A8A8A" />
                                        <TextBlock
                                            x:Name="State"
                                            Style="{StaticResource Caption}"
                                            Text="Stopped" />
                                        <TextBlock Style="{StaticResource Caption}" Text="  ·  " />
                                        <TextBlock Style="{StaticResource Caption}" Text="{Binding Details}" />
                                        <TextBlock
                                            Style="{StaticResource Caption}"
                                            Text="  ·  "
                                            Visibility="{Binding DiskText, Converter={StaticResource NullToVisibility}}" />
                                        <TextBlock Style="{StaticResource Caption}" Text="{Binding DiskText}" />
                                    </StackPanel>
                                    <StackPanel
                                        Margin="0,6,0,0"
                                        Orientation="Horizontal"
                                        Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}">
                                        <ui:ProgressRing
                                            Width="14"
                                            Height="14"
                                            IsIndeterminate="True" />
                                        <TextBlock
                                            Margin="6,0,0,0"
                                            Style="{StaticResource Caption}"
                                            Text="{Binding BusyText}" />
                                    </StackPanel>
                                </StackPanel>

                                <StackPanel
                                    Grid.Column="2"
                                    VerticalAlignment="Center"
                                    IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}"
                                    Orientation="Horizontal">
                                    <ui:Button
                                        Margin="4,0"
                                        AutomationProperties.Name="{Binding Name, StringFormat='Open {0}'}"
                                        Command="{Binding DataContext.OpenTerminalCommand, ElementName=Root}"
                                        CommandParameter="{Binding}"
                                        Content="Open"
                                        Icon="{ui:SymbolIcon WindowConsole20}" />
                                    <ui:Button
                                        x:Name="StopButton"
                                        Margin="4,0"
                                        AutomationProperties.Name="{Binding Name, StringFormat='Stop {0}'}"
                                        Command="{Binding DataContext.StopCommand, ElementName=Root}"
                                        CommandParameter="{Binding}"
                                        Content="Stop"
                                        Icon="{ui:SymbolIcon Stop24}"
                                        Visibility="Collapsed" />
                                    <ui:Button
                                        x:Name="More"
                                        Margin="4,0,0,0"
                                        AutomationProperties.Name="{Binding Name, StringFormat='More actions for {0}'}"
                                        Appearance="Transparent"
                                        Click="More_Click"
                                        Icon="{ui:SymbolIcon MoreHorizontal24}"
                                        Tag="{Binding DataContext, ElementName=Root}"
                                        ToolTip="More actions">
                                        <ui:Button.ContextMenu>
                                            <ContextMenu DataContext="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource Self}}">
                                                <MenuItem
                                                    Command="{Binding SetDefaultCommand}"
                                                    CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                    Header="Set as default"
                                                    Icon="{ui:SymbolIcon Star24}" />
                                                <MenuItem
                                                    Command="{Binding ToggleKeepAliveCommand}"
                                                    CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                    Header="Keep running in background"
                                                    Icon="{ui:SymbolIcon Pin24}"
                                                    IsChecked="{Binding PlacementTarget.DataContext.KeepAlive, RelativeSource={RelativeSource AncestorType=ContextMenu}, Mode=OneWay}" />
                                                <MenuItem
                                                    Command="{Binding EditConfigCommand}"
                                                    CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                    Header="Distribution settings (wsl.conf)…"
                                                    Icon="{ui:SymbolIcon DocumentSettings20}" />
                                                <Separator />
                                                <MenuItem
                                                    Command="{Binding CloneCommand}"
                                                    CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                    Header="Clone…"
                                                    Icon="{ui:SymbolIcon Copy24}" />
                                                <MenuItem
                                                    Command="{Binding ExportCommand}"
                                                    CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                    Header="Export backup…"
                                                    Icon="{ui:SymbolIcon ArrowExport24}" />
                                                <MenuItem
                                                    Command="{Binding MoveCommand}"
                                                    CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                    Header="Move to another folder…"
                                                    Icon="{ui:SymbolIcon FolderArrowRight24}" />
                                                <Separator />
                                                <MenuItem
                                                    Command="{Binding CompactCommand}"
                                                    CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                    Header="Compact disk…"
                                                    Icon="{ui:SymbolIcon ArrowMinimize24}" />
                                                <MenuItem
                                                    Command="{Binding MakeSparseCommand}"
                                                    CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                    Header="Shrink disk automatically (sparse)…"
                                                    Icon="{ui:SymbolIcon HardDrive20}" />
                                                <MenuItem
                                                    Command="{Binding OpenFolderCommand}"
                                                    CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                    Header="Show disk in Explorer"
                                                    Icon="{ui:SymbolIcon FolderOpen24}" />
                                                <Separator />
                                                <MenuItem
                                                    Command="{Binding UnregisterCommand}"
                                                    CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                    Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                                                    Header="Delete…"
                                                    Icon="{ui:SymbolIcon Delete24}" />
                                            </ContextMenu>
                                        </ui:Button.ContextMenu>
                                    </ui:Button>
                                </StackPanel>
                            </Grid>
                        </ui:Card>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                <Setter TargetName="Dot" Property="Fill" Value="#109E4A" />
                                <Setter TargetName="State" Property="Text" Value="Running" />
                                <Setter TargetName="StopButton" Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</Page>
