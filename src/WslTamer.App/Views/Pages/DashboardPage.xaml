<Page
    x:Class="WslTamer.App.Views.Pages.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:WslTamer.App.ViewModels"
    Title="Home"
    d:DataContext="{d:DesignInstance vm:DashboardViewModel}"
    mc:Ignorable="d">
    <ScrollViewer Style="{StaticResource PageScroller}">
        <StackPanel MaxWidth="900" HorizontalAlignment="Stretch">
            <TextBlock Style="{StaticResource PageTitle}" Text="Home" />
            <TextBlock Style="{StaticResource PageSubtitle}" Text="{Binding VersionText}" />

            <ui:InfoBar
                Title="WSL is not installed"
                Margin="0,0,0,12"
                IsClosable="False"
                IsOpen="{Binding WslMissing}"
                Message="WSL Tamer manages the Windows Subsystem for Linux. Install it to get started."
                Severity="Warning" />
            <ui:Button
                Margin="0,0,0,12"
                Command="{Binding InstallWslCommand}"
                Content="Install WSL"
                Visibility="{Binding WslMissing, Converter={StaticResource BoolToVisibility}}" />

            <ui:InfoBar
                Title="Restart WSL to apply your changes"
                Margin="0,0,0,4"
                IsClosable="False"
                IsOpen="{Binding RestartPending}"
                Message=".wslconfig changed while WSL was running. Settings take effect when WSL restarts."
                Severity="Warning" />
            <ui:Button
                Margin="0,0,0,12"
                Appearance="Caution"
                Command="{Binding RestartWslCommand}"
                Content="Restart WSL now"
                Icon="{ui:SymbolIcon ArrowClockwise24}"
                Visibility="{Binding RestartPending, Converter={StaticResource BoolToVisibility}}" />

            <ui:InfoBar
                Title="Background distributions are paused"
                Margin="0,0,0,4"
                IsClosable="False"
                IsOpen="{Binding KeepAlivePaused}"
                Message="They stopped when WSL was shut down."
                Severity="Informational" />
            <ui:Button
                Margin="0,0,0,12"
                Command="{Binding ResumeKeepAliveCommand}"
                Content="Resume"
                Icon="{ui:SymbolIcon Play24}"
                Visibility="{Binding KeepAlivePaused, Converter={StaticResource BoolToVisibility}}" />

            <!--  Status  -->
            <ui:Card Margin="0,0,0,12" Padding="20">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Ellipse
                        x:Name="StatusDot"
                        Width="14"
                        Height="14"
                        Margin="0,0,16,0"
                        VerticalAlignment="Center"
                        Fill="#8A8A8A" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock FontSize="18" FontWeight="SemiBold" Text="{Binding StatusText}" />
                        <TextBlock Style="{StaticResource Caption}" Text="{Binding StatusDetail}" />
                        <TextBlock
                            Style="{StaticResource Caption}"
                            Text="{Binding MemoryText}"
                            Visibility="{Binding MemoryText, Converter={StaticResource NullToVisibility}}" />
                    </StackPanel>
                    <WrapPanel Grid.Column="2" VerticalAlignment="Center">
                        <ui:Button
                            Margin="4"
                            Command="{Binding OpenTerminalCommand}"
                            Content="Open terminal"
                            Icon="{ui:SymbolIcon WindowConsole20}"
                            ToolTip="Open the default distribution in a terminal" />
                        <ui:Button
                            Margin="4"
                            Command="{Binding ReclaimMemoryCommand}"
                            Content="Reclaim memory"
                            Icon="{ui:SymbolIcon Broom24}"
                            IsEnabled="{Binding IsRunning}"
                            ToolTip="Drop Linux file caches and return the memory to Windows" />
                        <ui:Button
                            Margin="4"
                            Command="{Binding ShutdownWslCommand}"
                            Content="Shut down"
                            Icon="{ui:SymbolIcon Power24}"
                            IsEnabled="{Binding IsRunning}" />
                    </WrapPanel>
                </Grid>
            </ui:Card>

            <!--  Profile  -->
            <TextBlock Style="{StaticResource SectionHeader}" Text="Resource profile" />
            <ui:Card Padding="20">
                <StackPanel>
                    <TextBlock Style="{StaticResource CardTitle}" Text="{Binding ActiveProfileText}" />
                    <TextBlock
                        Margin="0,2,0,12"
                        Style="{StaticResource Caption}"
                        Text="Applying a profile updates only the settings it manages in .wslconfig. Everything else in the file is kept." />
                    <StackPanel Orientation="Horizontal">
                        <ComboBox
                            Width="240"
                            DisplayMemberPath="Name"
                            ItemsSource="{Binding Profiles}"
                            SelectedItem="{Binding SelectedProfile}" />
                        <ui:Button
                            Margin="8,0,0,0"
                            Appearance="Primary"
                            Command="{Binding ApplyProfileCommand}"
                            Content="Apply" />
                        <ui:Button
                            Margin="8,0,0,0"
                            Command="{Binding EditWslConfigCommand}"
                            Content="Open .wslconfig"
                            Icon="{ui:SymbolIcon DocumentEdit24}" />
                    </StackPanel>
                </StackPanel>
            </ui:Card>

            <StackPanel
                Margin="0,16,0,0"
                Orientation="Horizontal"
                Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}">
                <ui:ProgressRing
                    Width="20"
                    Height="20"
                    IsIndeterminate="True" />
                <TextBlock
                    Margin="8,0,0,0"
                    VerticalAlignment="Center"
                    Text="{Binding BusyText}" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
