<Page
    x:Class="WslTamer.App.Views.Pages.AutomationPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:local="clr-namespace:WslTamer.App.Views.Pages"
    xmlns:vm="clr-namespace:WslTamer.App.ViewModels"
    x:Name="Root"
    Title="Automation"
    d:DataContext="{d:DesignInstance vm:AutomationViewModel}"
    mc:Ignorable="d">
    <ScrollViewer Style="{StaticResource PageScroller}">
        <StackPanel MaxWidth="900">
            <TextBlock Style="{StaticResource PageTitle}" Text="Automation" />
            <TextBlock Style="{StaticResource PageSubtitle}" Text="Switch profiles automatically. Rules are checked every 20 seconds, top to bottom; the first match wins. A profile you pick by hand stays until conditions change." />

            <ui:Card Margin="0,0,0,12" Padding="16,12">
                <Grid>
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardTitle}" Text="Automatic profile switching" />
                        <TextBlock Style="{StaticResource Caption}" Text="Profile changes take effect when WSL restarts (see Settings → When a profile changes)." />
                    </StackPanel>
                    <ui:ToggleSwitch
                        HorizontalAlignment="Right"
                        AutomationProperties.Name="Automatic profile switching"
                        IsChecked="{Binding AutomationEnabled}" />
                </Grid>
            </ui:Card>

            <TextBlock Style="{StaticResource SectionHeader}" Text="Rules" />
            <TextBlock
                Margin="0,0,0,8"
                Style="{StaticResource Caption}"
                Text="No rules yet. Add one below."
                Visibility="{Binding Rules.Count, Converter={x:Static local:AutomationPageConverters.ZeroToVisible}}" />
            <ItemsControl ItemsSource="{Binding Rules}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:RuleItemViewModel}">
                        <ui:Card Margin="0,0,0,4" Padding="12,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ui:ToggleSwitch IsChecked="{Binding IsEnabled}" ToolTip="Enable or disable this rule" />
                                <TextBlock
                                    Grid.Column="1"
                                    Margin="12,0"
                                    VerticalAlignment="Center"
                                    Text="{Binding Description}"
                                    TextWrapping="Wrap" />
                                <StackPanel Grid.Column="2" Orientation="Horizontal">
                                    <ui:Button
                        AutomationProperties.Name="{Binding Description, StringFormat='Move up: {0}'}"
                                        Appearance="Transparent"
                                        Command="{Binding DataContext.MoveRuleUpCommand, ElementName=Root}"
                                        CommandParameter="{Binding}"
                                        Icon="{ui:SymbolIcon ArrowUp24}"
                                        ToolTip="Higher priority" />
                                    <ui:Button
                        AutomationProperties.Name="{Binding Description, StringFormat='Move down: {0}'}"
                                        Appearance="Transparent"
                                        Command="{Binding DataContext.MoveRuleDownCommand, ElementName=Root}"
                                        CommandParameter="{Binding}"
                                        Icon="{ui:SymbolIcon ArrowDown24}"
                                        ToolTip="Lower priority" />
                                    <ui:Button
                        AutomationProperties.Name="{Binding Description, StringFormat='Delete rule: {0}'}"
                                        Appearance="Transparent"
                                        Command="{Binding DataContext.DeleteRuleCommand, ElementName=Root}"
                                        CommandParameter="{Binding}"
                                        Icon="{ui:SymbolIcon Delete24}"
                                        ToolTip="Delete rule" />
                                </StackPanel>
                            </Grid>
                        </ui:Card>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Style="{StaticResource SectionHeader}" Text="Add a rule" />
            <ui:Card Padding="16">
                <StackPanel>
                    <WrapPanel>
                        <StackPanel Margin="0,0,12,8">
                            <TextBlock Margin="0,0,0,4" Text="When" />
                            <ComboBox
                                Width="220"
                                DisplayMemberPath="Label"
                                ItemsSource="{Binding TriggerTypes}"
                                SelectedItem="{Binding NewTrigger}" />
                        </StackPanel>
                        <StackPanel Margin="0,0,12,8">
                            <TextBlock Margin="0,0,0,4" Text="Value" />
                            <ui:TextBox
                                Width="240"
                                AutomationProperties.Name="Rule value"
                                PlaceholderText="{Binding Hint}"
                                Text="{Binding NewValue, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Margin="0,0,12,8">
                            <TextBlock Margin="0,0,0,4" Text="Use profile" />
                            <ComboBox
                                Width="180"
                                DisplayMemberPath="Name"
                                ItemsSource="{Binding TargetProfiles}"
                                SelectedItem="{Binding NewTarget}" />
                        </StackPanel>
                        <ui:Button
                            Margin="0,0,0,8"
                            VerticalAlignment="Bottom"
                            Appearance="Primary"
                            Command="{Binding AddRuleCommand}"
                            Content="Add rule"
                            Icon="{ui:SymbolIcon Add24}" />
                    </WrapPanel>
                    <TextBlock Style="{StaticResource Caption}" Text="{Binding Hint}" />
                    <TextBlock
                        Style="{StaticResource ErrorText}"
                        Text="{Binding NewRuleError}"
                        Visibility="{Binding NewRuleError, Converter={StaticResource NullToVisibility}}" />
                </StackPanel>
            </ui:Card>

            <TextBlock Style="{StaticResource SectionHeader}" Text="When no rule matches" />
            <ui:Card Padding="16,12">
                <Grid>
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardTitle}" Text="Fallback profile" />
                        <TextBlock Style="{StaticResource Caption}" Text="Applied when conditions stop matching every rule." />
                    </StackPanel>
                    <ComboBox
                        Width="220"
                        HorizontalAlignment="Right"
                        DisplayMemberPath="Name"
                        ItemsSource="{Binding FallbackOptions}"
                        SelectedItem="{Binding Fallback}" />
                </Grid>
            </ui:Card>

            <TextBlock Style="{StaticResource SectionHeader}" Text="Right now" />
            <ui:Card Padding="16,12">
                <Grid>
                    <TextBlock
                        FontFamily="Cascadia Mono, Consolas"
                        Text="{Binding CurrentConditions}"
                        TextWrapping="Wrap" />
                    <ui:Button
                        AutomationProperties.Name="Refresh"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Command="{Binding RefreshConditionsCommand}"
                        Icon="{ui:SymbolIcon ArrowSync24}"
                        ToolTip="Refresh" />
                </Grid>
            </ui:Card>
        </StackPanel>
    </ScrollViewer>
</Page>
