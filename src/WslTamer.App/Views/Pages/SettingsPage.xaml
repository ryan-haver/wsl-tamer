<Page
    x:Class="WslTamer.App.Views.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:WslTamer.App.ViewModels"
    Title="Settings"
    d:DataContext="{d:DesignInstance vm:SettingsViewModel}"
    mc:Ignorable="d">
    <ScrollViewer Style="{StaticResource PageScroller}">
        <StackPanel MaxWidth="900">
            <TextBlock Style="{StaticResource PageTitle}" Text="Settings" />
            <TextBlock Style="{StaticResource PageSubtitle}" Text="How WSL Tamer itself behaves." />

            <ui:Card Margin="0,0,0,4" Padding="16,12">
                <Grid>
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardTitle}" Text="Start with Windows" />
                        <TextBlock Style="{StaticResource Caption}" Text="Start in the notification area when you sign in." />
                    </StackPanel>
                    <ui:ToggleSwitch HorizontalAlignment="Right" IsChecked="{Binding StartWithWindows}" />
                </Grid>
            </ui:Card>

            <ui:Card Margin="0,0,0,4" Padding="16,12">
                <Grid>
                    <StackPanel Margin="0,0,260,0">
                        <TextBlock Style="{StaticResource CardTitle}" Text="When a profile changes" />
                        <TextBlock Style="{StaticResource Caption}" Text="WSL reads .wslconfig only when it starts, so a running WSL must restart to use new settings." />
                    </StackPanel>
                    <ComboBox
                        Width="250"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        DisplayMemberPath="Label"
                        ItemsSource="{Binding ApplyBehaviors}"
                        SelectedItem="{Binding SelectedApplyBehavior}" />
                </Grid>
            </ui:Card>

            <ui:Card Margin="0,0,0,4" Padding="16,12">
                <Grid>
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardTitle}" Text="Notifications" />
                        <TextBlock Style="{StaticResource Caption}" Text="Show notifications from the tray when the window is closed. Errors are always shown." />
                    </StackPanel>
                    <ui:ToggleSwitch HorizontalAlignment="Right" IsChecked="{Binding ShowNotifications}" />
                </Grid>
            </ui:Card>

            <TextBlock Style="{StaticResource SectionHeader}" Text="Updates" />
            <ui:Card Margin="0,0,0,4" Padding="16,12">
                <StackPanel>
                    <Grid>
                        <StackPanel>
                            <TextBlock Style="{StaticResource CardTitle}" Text="Check for updates at startup" />
                            <TextBlock Style="{StaticResource Caption}" Text="Updates come from GitHub Releases and are checksum-verified before installing." />
                        </StackPanel>
                        <ui:ToggleSwitch HorizontalAlignment="Right" IsChecked="{Binding CheckForUpdates}" />
                    </Grid>
                    <StackPanel Margin="0,12,0,0" Orientation="Horizontal">
                        <ui:Button
                            Margin="0,0,8,0"
                            Command="{Binding CheckNowCommand}"
                            Content="Check now" />
                        <ui:Button
                            Margin="0,0,8,0"
                            Appearance="Primary"
                            Command="{Binding InstallUpdateCommand}"
                            Content="Install update"
                            Visibility="{Binding UpdateAvailable, Converter={StaticResource BoolToVisibility}}" />
                        <TextBlock
                            VerticalAlignment="Center"
                            Style="{StaticResource Caption}"
                            Text="{Binding UpdateStatus}" />
                    </StackPanel>
                </StackPanel>
            </ui:Card>

            <TextBlock Style="{StaticResource SectionHeader}" Text="About" />
            <ui:Card Padding="16,12">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Image
                            Width="32"
                            Height="32"
                            Source="pack://application:,,,/Assets/app.ico" />
                        <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource CardTitle}">
                                <Run Text="WSL Tamer" />
                                <Run Text="{Binding Version, Mode=OneWay}" />
                            </TextBlock>
                            <TextBlock Style="{StaticResource Caption}" Text="Free and open source under the GNU GPL v3." />
                        </StackPanel>
                    </StackPanel>
                    <WrapPanel Margin="0,12,0,0">
                        <ui:Button
                            Margin="0,0,8,8"
                            Command="{Binding OpenRepositoryCommand}"
                            Content="GitHub" />
                        <ui:Button
                            Margin="0,0,8,8"
                            Command="{Binding ReportIssueCommand}"
                            Content="Report a problem" />
                        <ui:Button
                            Margin="0,0,8,8"
                            Command="{Binding OpenLogsCommand}"
                            Content="Open log folder" />
                        <ui:Button
                            Margin="0,0,8,8"
                            Command="{Binding OpenSettingsFolderCommand}"
                            Content="Show settings file" />
                    </WrapPanel>
                </StackPanel>
            </ui:Card>
        </StackPanel>
    </ScrollViewer>
</Page>
