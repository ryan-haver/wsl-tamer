<Page
    x:Class="WslTamer.App.Views.Pages.HardwarePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hw="clr-namespace:WslTamer.Core.Hardware;assembly=WslTamer.Core"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:WslTamer.App.ViewModels"
    x:Name="Root"
    Title="Hardware"
    d:DataContext="{d:DesignInstance vm:HardwareViewModel}"
    mc:Ignorable="d">
    <ScrollViewer Style="{StaticResource PageScroller}">
        <StackPanel MaxWidth="900">
            <Grid>
                <StackPanel>
                    <TextBlock Style="{StaticResource PageTitle}" Text="Hardware" />
                    <TextBlock Style="{StaticResource PageSubtitle}" Text="Pass USB devices and physical disks through to WSL 2." />
                </StackPanel>
                <ui:Button
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Command="{Binding RefreshCommand}"
                    Icon="{ui:SymbolIcon ArrowSync24}"
                    ToolTip="Refresh" />
            </Grid>

            <StackPanel
                Margin="0,0,0,8"
                Orientation="Horizontal"
                Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}">
                <ui:ProgressRing
                    Width="18"
                    Height="18"
                    IsIndeterminate="True" />
                <TextBlock
                    Margin="8,0,0,0"
                    VerticalAlignment="Center"
                    Text="{Binding BusyText}" />
            </StackPanel>

            <!--  USB  -->
            <Grid Margin="0,8,0,8">
                <TextBlock
                    Margin="0"
                    VerticalAlignment="Center"
                    Style="{StaticResource SectionHeader}"
                    Text="USB devices" />
                <StackPanel
                    HorizontalAlignment="Right"
                    Orientation="Horizontal"
                    Visibility="{Binding UsbIpdInstalled, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock
                        Margin="0,0,8,0"
                        VerticalAlignment="Center"
                        Style="{StaticResource Caption}"
                        Text="Attach to" />
                    <ComboBox
                        Width="200"
                        ItemsSource="{Binding Distributions}"
                        SelectedItem="{Binding TargetDistro}" />
                </StackPanel>
            </Grid>

            <ui:Card Padding="16" Visibility="{Binding UsbIpdInstalled, Converter={StaticResource InverseBoolToVisibility}}">
                <Grid>
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardTitle}" Text="usbipd-win is needed for USB passthrough" />
                        <TextBlock Style="{StaticResource Caption}" Text="Install it with: winget install usbipd — then reopen this page." />
                    </StackPanel>
                    <ui:Button
                        HorizontalAlignment="Right"
                        Command="{Binding InstallUsbIpdCommand}"
                        Content="Learn more" />
                </Grid>
            </ui:Card>

            <ItemsControl ItemsSource="{Binding UsbDevices}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type hw:UsbDevice}">
                        <ui:Card Margin="0,0,0,4" Padding="16,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ui:SymbolIcon FontSize="20" Symbol="UsbStick24" />
                                <StackPanel
                                    Grid.Column="1"
                                    Margin="12,0"
                                    VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource CardTitle}" Text="{Binding Description}" />
                                    <TextBlock Style="{StaticResource Caption}">
                                        <Run Text="Bus" />
                                        <Run Text="{Binding BusId, Mode=OneWay}" />
                                        <Run Text="·" />
                                        <Run Text="{Binding HardwareId, Mode=OneWay}" />
                                        <Run x:Name="StateText" Text="· not shared" />
                                    </TextBlock>
                                </StackPanel>
                                <ui:Button
                                    x:Name="Action"
                                    Grid.Column="2"
                                    Command="{Binding DataContext.ToggleUsbCommand, ElementName=Root}"
                                    CommandParameter="{Binding}"
                                    Content="Attach"
                                    Icon="{ui:SymbolIcon PlugConnected24}" />
                            </Grid>
                        </ui:Card>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsShared}" Value="True">
                                <Setter TargetName="StateText" Property="Text" Value="· shared" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsAttached}" Value="True">
                                <Setter TargetName="StateText" Property="Text" Value="· attached to WSL" />
                                <Setter TargetName="Action" Property="Content" Value="Detach" />
                                <Setter TargetName="Action" Property="Icon" Value="{ui:SymbolIcon PlugDisconnected24}" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock
                Margin="0,4,0,0"
                Style="{StaticResource Caption}"
                Text="Sharing a device for the first time asks for administrator permission. Keyboards and mice can't be shared without forcing and are best left alone."
                Visibility="{Binding UsbIpdInstalled, Converter={StaticResource BoolToVisibility}}" />

            <!--  Disks  -->
            <TextBlock Style="{StaticResource SectionHeader}" Text="Physical disks" />
            <TextBlock
                Margin="0,0,0,8"
                Style="{StaticResource Caption}"
                Text="Attach a whole disk to WSL (for example, a Linux-formatted drive). The disk goes offline in Windows while attached. Requires administrator permission." />
            <ItemsControl ItemsSource="{Binding Disks}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:DiskItem}">
                        <ui:Card Margin="0,0,0,4" Padding="16,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ui:SymbolIcon FontSize="20" Symbol="HardDrive20" />
                                <StackPanel
                                    Grid.Column="1"
                                    Margin="12,0"
                                    VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource CardTitle}" Text="{Binding Title}" />
                                    <TextBlock Style="{StaticResource Caption}" Text="{Binding Details}" />
                                </StackPanel>
                                <StackPanel
                                    Grid.Column="2"
                                    IsEnabled="{Binding Disk.CanMount}"
                                    Orientation="Horizontal">
                                    <ui:Button
                                        Margin="0,0,8,0"
                                        Command="{Binding DataContext.MountDiskCommand, ElementName=Root}"
                                        CommandParameter="{Binding}"
                                        Content="Attach" />
                                    <ui:Button
                                        Command="{Binding DataContext.UnmountDiskCommand, ElementName=Root}"
                                        CommandParameter="{Binding}"
                                        Content="Detach" />
                                </StackPanel>
                            </Grid>
                        </ui:Card>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</Page>
