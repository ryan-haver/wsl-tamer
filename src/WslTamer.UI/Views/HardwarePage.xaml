<UserControl x:Class="WslTamer.UI.Views.HardwarePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:converters="clr-namespace:WslTamer.UI.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="850">
    <UserControl.Resources>
        <converters:BooleanToAttachConverter x:Key="BooleanToAttachConverter"/>
        <Style x:Key="HelpIcon" TargetType="ui:SymbolIcon">
            <Setter Property="Symbol" Value="Info24"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Margin" Value="5,0,0,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Help"/>
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
        </Style>
    </UserControl.Resources>
    
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="16">
            <TextBlock Text="Hardware Integration" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,16"/>

            <!-- USB Devices Section -->
            <ui:Card Margin="0,0,0,16" Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="220"/>
                    </Grid.RowDefinitions>
                    
                    <TextBlock Grid.Row="0" Text="USB Devices" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <TextBlock Grid.Row="1" Text="Attach and detach Windows USB devices directly into WSL distributions using usbipd-win." Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" Margin="0,0,0,12"/>
                    
                    <Grid Grid.Row="2" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <ui:Button Click="BtnRefreshUsb_Click" ToolTip="Scan for connected USB devices." Appearance="Secondary" Margin="0,0,12,0">
                            <ui:Button.Icon>
                                <ui:SymbolIcon Symbol="ArrowSync24"/>
                            </ui:Button.Icon>
                        </ui:Button>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Name="TxtUsbStatus" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>
                            <TextBlock Name="TxtUsbInstallLink" VerticalAlignment="Center" Margin="10,0,0,0" Visibility="Collapsed">
                                <Hyperlink NavigateUri="https://github.com/dorssel/usbipd-win/releases" RequestNavigate="Hyperlink_RequestNavigate">
                                    Install usbipd-win
                                </Hyperlink>
                            </TextBlock>
                        </StackPanel>
                    </Grid>
                    
                    <DataGrid Name="DgUsbDevices" Grid.Row="3" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single"
                              Background="{DynamicResource ControlFillColorDefaultBrush}"
                              BorderBrush="{DynamicResource ControlElevationBorderBrush}"
                              BorderThickness="1">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Bus ID" Binding="{Binding BusId}" Width="80"/>
                            <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*" MinWidth="150"/>
                            <DataGridTextColumn Header="State" Binding="{Binding State}" Width="120"/>
                            <DataGridTemplateColumn Header="Action" Width="100">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ui:Button Content="{Binding IsAttached, Converter={StaticResource BooleanToAttachConverter}}" 
                                                 Click="BtnToggleUsb_Click" 
                                                 Tag="{Binding BusId}"
                                                 ToolTip="Attach/Detach this USB device to/from WSL."
                                                 Appearance="Primary"
                                                 Padding="8,4"
                                                 HorizontalAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </ui:Card>

            <!-- Physical Disks Section -->
            <ui:Card Margin="0,0,0,16" Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="180"/>
                    </Grid.RowDefinitions>
                    
                    <TextBlock Grid.Row="0" Text="Physical Disks" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <TextBlock Grid.Row="1" Text="Mount raw partition or entire physical drive directly to your WSL distribution." Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" Margin="0,0,0,12"/>
                    
                    <Grid Grid.Row="2" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <ui:Button Click="BtnRefreshDisks_Click" ToolTip="Scan for physical disks." Appearance="Secondary" Margin="0,0,12,0" VerticalAlignment="Center">
                            <ui:Button.Icon>
                                <ui:SymbolIcon Symbol="ArrowSync24"/>
                            </ui:Button.Icon>
                        </ui:Button>
                        <TextBlock Grid.Column="1" Text="Target Distro:" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,8,0"/>
                        <ComboBox Name="CboDiskDistro" Grid.Column="2" Width="160" VerticalAlignment="Center" DisplayMemberPath="Name" SelectedValuePath="Name" Margin="0,0,16,0"/>
                        <TextBlock Grid.Column="3" Text="Warning: Mounting physical disks requires Administrator privileges." VerticalAlignment="Center" Foreground="Orange" FontWeight="Medium" FontSize="12"/>
                    </Grid>
                    
                    <DataGrid Name="DgDisks" Grid.Row="3" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single"
                              Background="{DynamicResource ControlFillColorDefaultBrush}"
                              BorderBrush="{DynamicResource ControlElevationBorderBrush}"
                              BorderThickness="1">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Device ID" Binding="{Binding DeviceId}" Width="160"/>
                            <DataGridTextColumn Header="Model" Binding="{Binding Model}" Width="*" MinWidth="150"/>
                            <DataGridTextColumn Header="Size" Binding="{Binding Size}" Width="100"/>
                            <DataGridTemplateColumn Header="Mount" Width="80">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ui:Button Click="BtnMountDisk_Click" Tag="{Binding DeviceId}" ToolTip="Mount this physical disk into WSL." Appearance="Primary" Padding="6" HorizontalAlignment="Center">
                                            <ui:Button.Icon>
                                                <ui:SymbolIcon Symbol="Play24"/>
                                            </ui:Button.Icon>
                                        </ui:Button>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Unmount" Width="90">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ui:Button Click="BtnUnmountDisk_Click" Tag="{Binding DeviceId}" ToolTip="Unmount this disk from WSL." Padding="6" HorizontalAlignment="Center">
                                            <ui:Button.Icon>
                                                <ui:SymbolIcon Symbol="Stop24"/>
                                            </ui:Button.Icon>
                                        </ui:Button>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </ui:Card>

            <!-- Folder Mounts (drvfs) Section -->
            <ui:Card Margin="0,0,0,16" Padding="16">
                <StackPanel>
                    <TextBlock Text="Folder Mounts (drvfs)" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <TextBlock Text="Mount standard Windows directories/folders into target directories within Linux." Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" Margin="0,0,0,16"/>
                    
                    <ui:Card Margin="0,0,0,8" Padding="16,12">
                        <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <StackPanel Width="220" Margin="0,0,16,4" VerticalAlignment="Center">
                                <TextBlock Text="WSL Distribution" FontWeight="SemiBold" FontSize="14" TextWrapping="Wrap"/>
                                <TextBlock Text="Select the target Linux distribution for the mount" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" Margin="0,2,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <ComboBox Name="CboMountDistro" Width="200" DisplayMemberPath="Name" SelectedValuePath="Name" Margin="0,0,8,0"/>
                                <ui:Button Click="BtnRefreshMountDistros_Click" ToolTip="Refresh distributions list." Appearance="Secondary" Padding="8">
                                    <ui:Button.Icon>
                                        <ui:SymbolIcon Symbol="ArrowSync24"/>
                                    </ui:Button.Icon>
                                </ui:Button>
                            </StackPanel>
                        </WrapPanel>
                    </ui:Card>
                    
                    <ui:Card Margin="0,0,0,8" Padding="16,12">
                        <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <StackPanel Width="220" Margin="0,0,16,4" VerticalAlignment="Center">
                                <TextBlock Text="Windows Folder Path" FontWeight="SemiBold" FontSize="14" TextWrapping="Wrap"/>
                                <TextBlock Text="Specify the source Windows folder path" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" Margin="0,2,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                            <Grid Width="300" VerticalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ui:TextBox Name="TxtWindowsPath" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,8,0" PlaceholderText="C:\path\to\folder"/>
                                <ui:Button Grid.Column="1" Click="BtnBrowseFolder_Click" ToolTip="Browse for Windows folder" Padding="8" VerticalAlignment="Center">
                                    <ui:Button.Icon>
                                        <ui:SymbolIcon Symbol="Folder24"/>
                                    </ui:Button.Icon>
                                </ui:Button>
                            </Grid>
                        </WrapPanel>
                    </ui:Card>

                    <ui:Card Margin="0,0,0,16" Padding="16,12">
                        <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <StackPanel Width="220" Margin="0,0,16,4" VerticalAlignment="Center">
                                <TextBlock Text="Linux Mount Path" FontWeight="SemiBold" FontSize="14" TextWrapping="Wrap"/>
                                <TextBlock Text="The Linux location where folder will be mounted" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" Margin="0,2,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                            <Grid Width="300" VerticalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ui:TextBox Name="TxtWslPath" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,8,0" PlaceholderText="/mnt/wsl/folder"/>
                                <ui:SymbolIcon Grid.Column="1" Style="{StaticResource HelpIcon}" ToolTip="Example: /mnt/wsl/myfolder or /mnt/myfolder." VerticalAlignment="Center"/>
                            </Grid>
                        </WrapPanel>
                    </ui:Card>

                    <ui:Button Content="Mount Folder" Appearance="Primary" HorizontalAlignment="Right" Click="BtnMountFolder_Click" MinWidth="150" Padding="12,8">
                        <ui:Button.Icon>
                            <ui:SymbolIcon Symbol="Play24"/>
                        </ui:Button.Icon>
                    </ui:Button>
                </StackPanel>
            </ui:Card>

            <!-- PCIe Passthrough Section -->
            <ui:Card Margin="0,0,0,16" Padding="16">
                <StackPanel>
                    <TextBlock Text="PCIe Passthrough (Advanced DDA)" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <TextBlock Text="Discrete Device Assignment (DDA) enables direct pass-through of PCIe hardware (e.g., discrete GPUs) to WSL." Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" Margin="0,0,0,12"/>
                    
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <TextBlock Text="Hardware Requirements:" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,8,0"/>
                        <TextBlock Text="SR-IOV" TextDecorations="Underline" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,0,12,0" Cursor="Help"
                                   ToolTip="Single Root I/O Virtualization must be active in BIOS/UEFI."/>
                        <TextBlock Text="IOMMU" TextDecorations="Underline" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,0,12,0" Cursor="Help"
                                   ToolTip="IOMMU (Intel VT-d or AMD-Vi) must be active in BIOS/UEFI."/>
                        <TextBlock Text="Admin Rights" TextDecorations="Underline" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Cursor="Help"
                                   ToolTip="Requires Administrator rights to detach PCIe devices from the host Windows OS."/>
                    </StackPanel>
                    
                    <Border Background="#1AFFFF00" BorderBrush="Orange" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <ui:SymbolIcon Symbol="Warning24" Foreground="Orange" FontSize="20" VerticalAlignment="Center" Margin="0,0,12,0"/>
                            <TextBlock Grid.Column="1" Text="Warning: Detaching host PCIe devices (especially primary GPUs) from Windows can cause system instability or display output failure." Foreground="{DynamicResource TextFillColorPrimaryBrush}" FontSize="12" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                    
                    <ui:Button Content="Manage PCIe Devices" IsEnabled="False" HorizontalAlignment="Left" Appearance="Secondary">
                        <ui:Button.Icon>
                            <ui:SymbolIcon Symbol="DeveloperBoard24"/>
                        </ui:Button.Icon>
                    </ui:Button>
                </StackPanel>
            </ui:Card>
        </StackPanel>
    </ScrollViewer>
</UserControl>