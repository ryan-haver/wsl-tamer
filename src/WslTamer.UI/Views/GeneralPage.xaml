<UserControl x:Class="WslTamer.UI.Views.GeneralPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             mc:Ignorable="d" 
             d:DesignHeight="650" d:DesignWidth="800">
    <UserControl.Resources>
        <Style x:Key="HelpIcon" TargetType="ui:SymbolIcon">
            <Setter Property="Symbol" Value="Info24"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Margin" Value="5,0,0,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Help"/>
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
        </Style>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="16">
            <TextBlock Text="General Settings" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,16"/>

            <!-- App Preferences Group -->
            <TextBlock Text="Preferences" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,8"/>
            <ui:Card Margin="0,0,0,16" Padding="16,12">
                <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <StackPanel Width="220" Margin="0,0,16,4" VerticalAlignment="Center">
                        <TextBlock Text="Start on Startup" FontWeight="SemiBold" FontSize="14" TextWrapping="Wrap"/>
                        <TextBlock Text="Automatically launch WSL Tamer when you log in to Windows" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" Margin="0,2,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                    <ui:ToggleSwitch Name="ChkStartOnLogin" Click="ChkStartOnLogin_Click" VerticalAlignment="Center"/>
                </WrapPanel>
            </ui:Card>

            <!-- Global Actions Group -->
            <TextBlock Text="Global Actions" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,8,0,8"/>
            
            <ui:Card Margin="0,0,0,8" Padding="16,12">
                <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <ui:SymbolIcon Symbol="Prompt24" FontSize="20" Margin="0,0,12,4" VerticalAlignment="Center"/>
                    <StackPanel Width="220" Margin="0,0,16,4" VerticalAlignment="Center">
                        <TextBlock Text="Open Terminal" FontWeight="SemiBold" FontSize="14" TextWrapping="Wrap"/>
                        <TextBlock Text="Launch a command line terminal for the default WSL distribution" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" Margin="0,2,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                    <ui:Button Content="Launch Terminal" Click="BtnLaunchWsl_Click" Appearance="Primary" MinWidth="130" VerticalAlignment="Center"/>
                </WrapPanel>
            </ui:Card>

            <ui:Card Margin="0,0,0,8" Padding="16,12">
                <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <ui:SymbolIcon Symbol="Play24" FontSize="20" Margin="0,0,12,4" VerticalAlignment="Center"/>
                    <StackPanel Width="220" Margin="0,0,16,4" VerticalAlignment="Center">
                        <TextBlock Text="Start in Background" FontWeight="SemiBold" FontSize="14" TextWrapping="Wrap"/>
                        <TextBlock Text="Boot WSL in the background to spin up system daemons without opening terminal windows" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" Margin="0,2,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                    <ui:Button Content="Start WSL" Click="BtnStartBackground_Click" MinWidth="130" VerticalAlignment="Center"/>
                </WrapPanel>
            </ui:Card>

            <ui:Card Margin="0,0,0,8" Padding="16,12">
                <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <ui:SymbolIcon Symbol="Broom24" FontSize="20" Margin="0,0,12,4" VerticalAlignment="Center"/>
                    <StackPanel Width="220" Margin="0,0,16,4" VerticalAlignment="Center">
                        <TextBlock Text="Reclaim RAM Cache" FontWeight="SemiBold" FontSize="14" TextWrapping="Wrap"/>
                        <TextBlock Text="Instruct the Linux kernel to drop page caches and return unused RAM to Windows host" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" Margin="0,2,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                    <ui:Button Content="Free Memory" Click="BtnReclaimMemory_Click" MinWidth="130" VerticalAlignment="Center"/>
                </WrapPanel>
            </ui:Card>

            <ui:Card Margin="0,0,0,8" Padding="16,12">
                <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <ui:SymbolIcon Symbol="FolderOpen24" FontSize="20" Margin="0,0,12,4" VerticalAlignment="Center"/>
                    <StackPanel Width="220" Margin="0,0,16,4" VerticalAlignment="Center">
                        <TextBlock Text="Open WSL File Share" FontWeight="SemiBold" FontSize="14" TextWrapping="Wrap"/>
                        <TextBlock Text="Access the Linux file system using Windows File Explorer" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" Margin="0,2,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                    <ui:Button Content="Open Explorer" Click="BtnOpenExplorer_Click" MinWidth="130" VerticalAlignment="Center"/>
                </WrapPanel>
            </ui:Card>

            <ui:Card Margin="0,0,0,8" Padding="16,12">
                <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <ui:SymbolIcon Symbol="Power24" FontSize="20" Margin="0,0,12,4" VerticalAlignment="Center"/>
                    <StackPanel Width="220" Margin="0,0,16,4" VerticalAlignment="Center">
                        <TextBlock Text="Shutdown WSL" FontWeight="SemiBold" FontSize="14" TextWrapping="Wrap"/>
                        <TextBlock Text="Send a graceful shutdown request to terminate all active Linux environments" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" Margin="0,2,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                    <ui:Button Content="Shutdown All" Click="BtnShutdownWsl_Click" Appearance="Secondary" MinWidth="130" VerticalAlignment="Center"/>
                </WrapPanel>
            </ui:Card>

            <ui:Card Margin="0,0,0,16" Padding="16,12">
                <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <ui:SymbolIcon Symbol="Delete24" Foreground="Red" FontSize="20" Margin="0,0,12,4" VerticalAlignment="Center"/>
                    <StackPanel Width="220" Margin="0,0,16,4" VerticalAlignment="Center">
                        <TextBlock Text="Force Kill WSL Service" FontWeight="SemiBold" FontSize="14" TextWrapping="Wrap"/>
                        <TextBlock Text="Immediately kill all running environments and WSL backend processes (potential data loss)" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" Margin="0,2,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                    <ui:Button Content="Kill WSL" Click="BtnKillAll_Click" Foreground="Red" MinWidth="130" VerticalAlignment="Center"/>
                </WrapPanel>
            </ui:Card>
        </StackPanel>
    </ScrollViewer>
</UserControl>
