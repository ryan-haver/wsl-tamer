<UserControl x:Class="WslTamer.UI.Views.AboutPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             mc:Ignorable="d" 
             d:DesignHeight="500" d:DesignWidth="800">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="16">
            <!-- App Branding Header -->
            <ui:Card Margin="0,0,0,16" Padding="16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Image Source="/Assets/app.ico" Width="64" Height="64" Margin="0,0,16,0" VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="WSL Tamer" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,2"/>
                        <TextBlock Name="TxtVersion" Text="Version 1.0.0" FontSize="13" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                        <TextBlock Text="A modern WSL2 distribution manager and settings profile automation tool." FontSize="12" Margin="0,6,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>
                </Grid>
            </ui:Card>

            <!-- Updates Section -->
            <TextBlock Text="Application Updates" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,8"/>
            <ui:Card Margin="0,0,0,8" Padding="16,12">
                <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <StackPanel Width="220" Margin="0,0,16,4" VerticalAlignment="Center">
                        <TextBlock Text="Automatic Update Checks" FontWeight="SemiBold" FontSize="14" TextWrapping="Wrap"/>
                        <TextBlock Text="Automatically check for updates when WSL Tamer starts up" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" Margin="0,2,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                    <ui:ToggleSwitch Name="ChkAutoCheckUpdates" IsChecked="True" VerticalAlignment="Center"/>
                </WrapPanel>
            </ui:Card>

            <ui:Card Margin="0,0,0,16" Padding="16,12">
                <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <StackPanel Width="220" Margin="0,0,16,4" VerticalAlignment="Center">
                        <TextBlock Text="Check for Updates" FontWeight="SemiBold" FontSize="14" TextWrapping="Wrap"/>
                        <TextBlock Text="Manually query the online registry for the latest release" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" Margin="0,2,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Name="TxtUpdateStatus" VerticalAlignment="Center" Margin="0,0,12,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                        <ui:Button Content="Check Now" Click="BtnCheckUpdates_Click" Appearance="Secondary">
                            <ui:Button.Icon>
                                <ui:SymbolIcon Symbol="ArrowSync24"/>
                            </ui:Button.Icon>
                        </ui:Button>
                    </StackPanel>
                </WrapPanel>
            </ui:Card>

            <!-- Project Info & Support Section -->
            <TextBlock Text="Project Information" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,8,0,8"/>
            <ui:Card Padding="16" Margin="0,0,0,16">
                <StackPanel>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="GitHub Repository:" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                        <TextBlock Grid.Column="1">
                            <Hyperlink NavigateUri="https://github.com/ryan-haver/wsl-tamer" RequestNavigate="Hyperlink_RequestNavigate">
                                github.com/ryan-haver/wsl-tamer
                            </Hyperlink>
                        </TextBlock>
                    </Grid>

                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Developer:" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                        <TextBlock Grid.Column="1" Text="Ryan Haver" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                    </Grid>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="License:" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                        <TextBlock Grid.Column="1" Text="MIT License" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                    </Grid>
                </StackPanel>
            </ui:Card>
        </StackPanel>
    </ScrollViewer>
</UserControl>